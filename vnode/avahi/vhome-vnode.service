<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Discovery only; the phone trusts the pinned certificate, never this record. The installer replaces
     @NODE_ID16@ with the first 16 hex of the node certificate's SHA-256. -->
<service-group>
  <name replace-wildcards="yes">V/HOME node on %h</name>
  <service>
    <type>_vhome._tcp</type>
    <port>8443</port>
    <txt-record>api=1</txt-record>
    <txt-record>id=@NODE_ID16@</txt-record>
  </service>
</service-group>
