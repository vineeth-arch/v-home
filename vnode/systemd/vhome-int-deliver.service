[Unit]
Description=V/HOME inbox delivery worker (optional: runs on the Pi so delivery works with the Mac off)
# Not tied to vhome-vnode or vhome-integrations: if the socket is missing the worker logs it and retries on the next poll.
# network-online + time-sync: Brain is reached over https from here, and a Pi Zero has no RTC (the worker also checks the clock itself).
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
# Same user and group as vhome-integrations: owns /run/vhome-integrations/int.sock (0660 group vhome-intsock).
User=vhome-int
Group=vhome-intsock
Environment=PYTHONPATH=/opt/vhome-vnode/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 0640 root:vhome-int, written by install-pi.sh --with-worker. Holds the Brain token (and Access service token if used).
EnvironmentFile=/etc/vhome-int/deliver.env
ExecStart=/usr/bin/python3 -m vhome_companion.integrations.worker.main --live --from-env
# /var/lib/vhome-int-deliver holds only the delivery ledger (delivered.db).
StateDirectory=vhome-int-deliver
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300
RestartPreventExitStatus=78
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0077
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

# Resource limits: the TV controller always wins on a one-core Pi Zero W.
MemoryMax=48M
CPUQuota=20%
TasksMax=16
Nice=15
IOWeight=10

# Hardening: same block as vhome-integrations.service; sockets are the unix socket plus outbound https to Brain.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
