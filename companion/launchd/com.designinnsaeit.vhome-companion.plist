<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: companion/install.sh fills in the @...@ values and writes it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.designinnsaeit.vhome-companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>-m</string>
    <string>vhome_companion</string>
    <string>watch</string>
    <string>--service</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VHOME_COMPANION_DIR</key>
    <string>@STATE_DIR@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart only after a crash; a clean exit (not paired yet, no Home id yet) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>@STATE_DIR@/launchd.err.log</string>
</dict>
</plist>
