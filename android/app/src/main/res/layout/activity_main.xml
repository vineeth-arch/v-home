<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            style="@style/T.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:text="@string/app_title" />

        <View style="@style/Rule" />

        <!-- First run: three numbered steps replace the status hero until the TV is paired. -->
        <LinearLayout
            android:id="@+id/firstRun"
            style="@style/Section"
            android:visibility="gone">

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/first_title" />

            <TextView
                android:id="@+id/firstExplain"
                style="@style/T.Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/yellow"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:text="1"
                    android:textColor="@color/on_colour"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:text="@string/step1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/blue"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:text="2"
                    android:textColor="@color/on_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step2Label"
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/stepHostField"
                        android:text="@string/step2" />

                    <EditText
                        android:id="@+id/stepHostField"
                        style="@style/Field"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_tv_ip" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/red"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:text="3"
                    android:textColor="@color/on_colour"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/step3" />

                    <Button
                        android:id="@+id/stepPairButton"
                        style="@style/Btn.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/pair" />

                    <TextView
                        android:id="@+id/stepResult"
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="10dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Status hero: a Mondrian split, state block left (~62%), today's count right. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/heroBlock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="62"
                    android:background="@color/blue"
                    android:minHeight="176dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/heroTitle"
                        style="@style/T.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" />

                    <TextView
                        android:id="@+id/heroDetail"
                        style="@style/T.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="38"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/countValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/countLabel"
                        style="@style/T.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Rule" />

            <LinearLayout style="@style/Section">

                <TextView
                    android:id="@+id/heroExplain"
                    style="@style/T.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/primaryButton"
                        style="@style/Btn.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/pauseButton"
                        style="@style/Btn.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pause" />
                </LinearLayout>

                <!-- Inline pause choices, no modal. -->
                <LinearLayout
                    android:id="@+id/pauseChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pause_for" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pause30"
                            style="@style/Btn.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/pause_30" />

                        <Button
                            android:id="@+id/pause60"
                            style="@style/Btn.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/pause_60" />

                        <Button
                            android:id="@+id/pause120"
                            style="@style/Btn.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/pause_120" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/pauseOpen"
                        style="@style/Btn.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/pause_open" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Rule" />

        <!-- Setup checklist -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/section_setup" />

            <include
                android:id="@+id/rowDone"
                layout="@layout/row_check"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/setupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/hairline"
                android:orientation="vertical"
                android:showDividers="middle">

                <include android:id="@+id/rowPaired" layout="@layout/row_check" />
                <include android:id="@+id/rowNotif" layout="@layout/row_check" />
                <include android:id="@+id/rowBattery" layout="@layout/row_check" />
                <include android:id="@+id/rowBackground" layout="@layout/row_check" />
                <include android:id="@+id/rowBucket" layout="@layout/row_check" />
                <include android:id="@+id/rowSleep" layout="@layout/row_check" />
                <include android:id="@+id/rowRecents" layout="@layout/row_check" />
                <include android:id="@+id/rowQuickStart" layout="@layout/row_check" />
            </LinearLayout>
        </LinearLayout>

        <!-- TV -->
        <LinearLayout
            android:id="@+id/tvSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View style="@style/Rule" />

            <LinearLayout style="@style/Section">

                <TextView
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_tv" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/editIpButton"
                        style="@style/Btn.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_ip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ipEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FieldLabel"
                        android:labelFor="@+id/hostField"
                        android:text="@string/hint_tv_ip" />

                    <EditText
                        android:id="@+id/hostField"
                        style="@style/Field" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/testButton"
                        style="@style/Btn.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/test_tv" />

                    <Button
                        android:id="@+id/pairButton"
                        style="@style/Btn.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/pair_again" />
                </LinearLayout>

                <Button
                    android:id="@+id/openTvButton"
                    style="@style/Btn.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/open_on_tv" />

                <TextView
                    android:id="@+id/openTvHint"
                    style="@style/T.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvResult"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="10dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Rule" />

        <!-- Behaviour -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_behaviour" />

            <Switch
                android:id="@+id/doubleHomeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="@string/double_home"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                style="@style/T.Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/double_home_help" />
        </LinearLayout>

        <View style="@style/Rule" />

        <!-- Advanced, collapsed -->
        <LinearLayout
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_advanced" />

            <TextView
                android:id="@+id/advancedToggle"
                style="@style/T.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedBody"
            style="@style/Section"
            android:paddingTop="0dp"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/vhomeField"
                android:text="@string/hint_vhome_id" />

            <EditText
                android:id="@+id/vhomeField"
                style="@style/Field" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/homeIdsField"
                android:text="@string/hint_home_ids" />

            <EditText
                android:id="@+id/homeIdsField"
                style="@style/Field" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    style="@style/Btn.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />

                <TextView
                    android:id="@+id/savedText"
                    style="@style/T.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="10dp" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="40dp"
                android:labelFor="@+id/sinkField"
                android:text="@string/hint_sink" />

            <EditText
                android:id="@+id/sinkField"
                style="@style/Field"
                android:hint="@string/sink_example" />

            <TextView
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/section_log" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/paper_2"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copyLogButton"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/copy_log" />

            <Button
                android:id="@+id/sendLogButton"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/send_log" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
