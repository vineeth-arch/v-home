<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.VHome" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHighlight">#331D3FBF</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.VHome" parent="Base.Theme.VHome" />

    <!-- Text -->
    <style name="T" />
    <style name="T.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    <style name="T.Dim">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    <style name="T.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="T_Small_Header" parent="T.Small">
        <item name="android:textColor">@color/text_dim</item>
    </style>
    <style name="T.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Structure -->
    <style name="Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:background">@color/ink</item>
    </style>
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- Health dashboard banner -->
    <style name="HealthBanner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="HealthBannerGlyph">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_blue</item>
    </style>
    <style name="HealthBannerTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_blue</item>
    </style>
    <style name="HealthBannerSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_blue</item>
    </style>

    <!-- Buttons -->
    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_colour</item>
        <!-- ink on spec red is ~3.4:1: passes only as large text (>=18sp bold) -->
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- node screen: red now means error, so its primary buttons use the hero blue (paper text is ~8:1 on it) -->
    <style name="Btn.NodePrimary" parent="Btn.Primary">
        <item name="android:background">@drawable/node_btn_primary</item>
        <item name="android:textColor">@color/on_blue</item>
    </style>
    <style name="Btn.Ghost">
        <item name="android:background">@drawable/btn_ghost</item>
    </style>
    <style name="Btn.Text">
        <item name="android:background">@drawable/row_ripple</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Inputs: label above, sharp box -->
    <style name="FieldLabel" parent="T.Small">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textUri</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
